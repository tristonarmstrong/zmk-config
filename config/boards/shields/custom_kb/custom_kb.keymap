#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {


        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Base";
// -----------------------------------------------------------------------------------------
// | TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  ?  |
// | CAPS|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  ?  |
// | SHFT|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |  ?  |
//                   | GUI | RSE | SPC |   | ENT | LWR  | ALT |
						bindings = <
   &kp TAB &kp Q &kp W &kp E &kp R &kp T         &kp Y &kp U  &kp I     &kp O   &kp P &none
   &kp CAPSLOCK &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &none
   &kp LSHFT &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &none
                  &kp LGUI &mo 2 &kp SPACE      &kp RET &mo 1 &kp RALT
						>;
                };
                lower_layer {
                        display-name = "Lower";
// -----------------------------------------------------------------------------------------
// |     |  1  |  2  |  3  |  4  |  5  |   |  6  |  7   |  8  |  9  |  0  |  ?  |
// |     | TAB | ESC |  [  |  ]  | \ | |   | LFT | DWN  | UP  | RGT |  '  |  ?  |
// |     | SHFT|     |  -  |  =  | GRV |   | HOME| PGDN | PGUP| END | SHFT|  ?  |
//                   | GUI | RSE | SPC |   | ENT | BSPC | ALT |
                        bindings = <
   &trans &kp N1    &kp N2   &kp N3    &kp N4    &kp N5       &kp N6   &kp N7    &kp N8    &kp N9    &kp N0 &none
   &trans &kp TAB   &kp ESC  &kp LBKT  &kp RBKT  &kp BSLH     &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp SQT &none
   &trans &trans    &trans   &kp MINUS &kp EQUAL &kp GRAVE    &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans &none
                                 &kp LGUI &trans &kp SPACE    &kp RET &kp BSPC &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise";
// -----------------------------------------------------------------------------------------
// |      |  F1  |  F2  |  F3  |  F4  |  F5  |   |  F6  |  F7  |  F8  |  F9  | F10 |  ?   |
// |      | BTCLR| BT1  | BT2  | BT3  | BT4  |   | F11  | F12  |VOLUP |VOLDN |MUTE |  ?   |
// |      | CTRL |      |      |      |      |   |      |      |      |      | DEL |  ?   |
//                      | GUI  | BSPC | SPC  |   | ENT  | LWR  | ALT  |
                        bindings = <
   &trans &kp F1       &kp F2       &kp F3       &kp F4       &kp F5           &kp F6   &kp F7   &kp F8       &kp F9       &kp F10 &none
   &trans &bt BT_CLR   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3     &kp F11  &kp F12  &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &none
   &trans &kp LCTRL    &bootloader  &trans       &trans       &trans           &trans   &trans   &trans       &trans       &kp DEL &none
                                            &kp LGUI &kp BSPC &kp SPACE        &kp RET &trans &kp RALT
                        >;
                };
        };
};
